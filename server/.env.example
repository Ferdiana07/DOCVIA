PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/docvia
# Optional local-only fallback when MongoDB or Atlas is unavailable. Data resets on restart.
USE_IN_MEMORY_DB=false
# Optional fixed port so local seed/migration scripts can connect to the fallback instance.
MONGO_MEMORY_PORT=27018
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Required for production admin seeding. Never commit a real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=System Administrator

# Optional local-only password used by utils/seedDummyData.js.
DUMMY_USER_PASSWORD=replace-with-a-local-demo-password

# Optional production email reminders (Resend)
RESEND_API_KEY=
EMAIL_FROM=DOCVIA <appointments@example.com>

# Optional production SMS reminders (Twilio, E.164 phone numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
REMINDER_INTERVAL_MS=300000
